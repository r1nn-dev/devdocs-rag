root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 120

[*.py]
indent_size = 4
max_line_length = 100

[*.{js,jsx,ts,tsx,json,yml,yaml,toml,sql}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false